{
  "realm": "routemesh",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      { "name": "OPS", "description": "Operations staff" },
      { "name": "MERCHANT", "description": "Merchant creating shipments" },
      { "name": "COURIER", "description": "Courier delivering shipments" },
      { "name": "WAREHOUSE", "description": "Warehouse staff" },
      { "name": "WORKFLOW", "description": "Workflow orchestrator service account" }
    ]
  },
  "clients": [
    {
      "clientId": "routemesh-web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "protocolMappers": [
        {
          "name": "routemesh-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "routemesh-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "workflow-service",
